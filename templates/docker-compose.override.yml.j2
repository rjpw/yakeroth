# docker-compose.override.yml - Site-specific service overrides for {{ site }}
# This file extends the base docker-compose.yml from AzerothCore
# See: https://www.azerothcore.org/wiki/install-with-docker

version: "3.8"

services:
  # Worldserver with site-specific image
  worldserver:
    image: acore-{{ site }}-worldserver:latest
    # Build args are set by yakeroth build command
    # build:
    #   context: ../../../..  # yakeroth repo root
    #   dockerfile: docker/Dockerfile
    #   args:
    #     AC_REPO: https://github.com/azerothcore/azerothcore-wotlk.git
    #     AC_REF: master
    #     SITE_MODULES_DIR: ./sites/{{ site }}/modules
    #     SITE_CMAKE_FILE: ./sites/{{ site }}/ModulesSite.cmake
    #     SITE_SQL_DIR: ./sites/{{ site }}/sql
    #     SITE_NAME: {{ site }}
    environment:
      # Server configuration (AC_ prefix convention)
      # See: https://www.azerothcore.org/wiki/config-options
      # These are overridden by env/env.ac and env/.env
      - CONFIG_DIR=/azerothcore/env/dist/etc

  # Authserver uses same image as worldserver
  authserver:
    image: acore-{{ site }}-worldserver:latest

  # Database - use pre-built image with digest pinning for reproducibility
  # See: https://github.com/azerothcore/azerothcore-wotlk/tree/master/apps/docker
  db:
    image: acore/ac-wotlk-db:master@sha256:REPLACE_WITH_ACTUAL_DIGEST
    # Or use latest for development:
    # image: acore/ac-wotlk-db:master
    volumes:
      # Database volume name follows pattern: <project>_ac-database
      - {{ project_name }}_ac-database:/var/lib/mysql
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: acore
      MYSQL_USER: acore
      MYSQL_PASSWORD: acore

  # DB Import - runs schema updates on startup
  db-import:
    image: acore-{{ site }}-worldserver:latest
    depends_on:
      - db
    environment:
      AC_UPDATES_ENABLE_DATABASES: 1  # Set to 0 in production, let db-import handle updates
      AC_DATABASE_HOST: db
      AC_DATABASE_PORT: 3306
      AC_DATABASE_USER: root
      AC_DATABASE_PASSWORD: root
    command: >
      bash -c "
        /home/acore/worldserver --db-only &
        wait
      "

volumes:
  {{ project_name }}_ac-database:
    external: false
    # For production, consider making this external and managed separately:
    # external: true
    # name: {{ project_name }}_ac-database

networks:
  default:
    name: {{ project_name }}_network